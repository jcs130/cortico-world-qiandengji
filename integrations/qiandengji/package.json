{
  "name": "cortico-world-qiandengji",
  "version": "0.4.1-rc.40",
  "type": "module",
  "description": "通用 Minecraft Agent World，内置现代 Web 可视化，可选千灯纪服务器资料包。",
  "main": "./dist/world/index.js",
  "exports": {
    ".": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./host-decisions": {
      "types": "./dist/host-decisions.d.ts",
      "default": "./dist/host-decisions.js"
    },
    "./packs/qiandengji": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    }
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "联机版我的世界",
    "tags": [
      "game",
      "creative",
      "memory",
      "external-setup",
      "experimental",
      "internal-state",
      "unsafe",
      "high-cost"
    ],
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json"
  },
  "keywords": [
    "cortico-world",
    "minecraft",
    "mineflayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git",
    "directory": "integrations/qiandengji"
  },
  "homepage": "https://github.com/jcs130/cortico-world-qiandengji#readme",
  "bugs": {
    "url": "https://github.com/jcs130/cortico-world-qiandengji/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "agent-mc-world": "^0.5.7-rc.104",
    "agent-mc-qiandengji": "^0.5.0-rc.34",
    "vec3": "0.2.0"
  },
  "peerDependencies": {
    "cortico": ">=0.2.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "cortico": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "describe.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-extensions.mjs",
    "prepack": "node dist/verify.mjs",
    "verify:webui": "node dist/verify-webui.mjs"
  },
  "types": "./dist/world/index.d.ts"
}
