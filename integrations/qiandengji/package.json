{
  "name": "cortico-world-qiandengji",
  "version": "0.4.1-dev.20261017.1",
  "type": "module",
  "description": "通用 Minecraft Agent World，内置现代 Web 可视化，可选千灯纪服务器资料包。",
  "main": "./dist/world/index.js",
  "exports": {
    ".": "./dist/world/index.js",
    "./host-decisions": "./dist/host-decisions.js",
    "./packs/qiandengji": "./dist/pack.js"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "联机版我的世界",
    "webUiClient": "dist/console.js",
    "webUiStyle": "dist/console.css",
    "describe": "describe.json"
  },
  "keywords": [
    "cortico-world",
    "minecraft",
    "mineflayer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git",
    "directory": "integrations/qiandengji"
  },
  "homepage": "https://github.com/jcs130/cortico-world-qiandengji#readme",
  "bugs": {
    "url": "https://github.com/jcs130/cortico-world-qiandengji/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "agent-mc-world": "^0.5.7-dev.20261017.1",
    "agent-mc-qiandengji": "^0.5.0-dev.20261017.1",
    "vec3": "0.2.0"
  },
  "peerDependencies": {
    "cortico": ">=0.2.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "cortico": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build-extensions.mjs",
    "prepack": "node dist/verify.mjs"
  }
}
