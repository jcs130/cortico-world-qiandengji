{
  "name": "cortico-world-qiandengji-lite",
  "version": "0.2.1",
  "type": "module",
  "description": "千灯纪-lite：复用 agent-mc-world 共享内核的14工具远程接入扩展，保留私密登录、官网接入和只读诊断。",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "packageManager": "pnpm@11.28.6",
  "keywords": [
    "cortico-world",
    "minecraft",
    "qiandengji",
    "cortico"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git",
    "directory": "integrations/qiandengji-lite"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "千灯纪-lite",
    "tags": [
      "game",
      "external-setup",
      "experimental",
      "unsafe",
      "high-cost"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css"
  },
  "files": [
    "dist/index.js",
    "dist/webui.js",
    "dist/webui.css",
    "dist/lite-environment.txt",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "UPSTREAM.json",
    "scripts/verify.mjs",
    "client/migrate-lite-config.mjs",
    "client/README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:stage": "node scripts/stage.mjs",
    "prepack": "node scripts/verify.mjs"
  },
  "dependencies": {
    "agent-mc-world": "0.5.7-rc.160-preview.142",
    "agent-mc-qiandengji": "0.5.0-rc.50-preview.108"
  },
  "peerDependencies": {
    "cortico": ">=0.2.17 <0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "0.2.17",
    "esbuild": "0.28.2",
    "typescript": "^5.7.2",
    "vitest": "2.1.8",
    "tsx": "^4.19.2",
    "jsdom": "30.0.1",
    "agent-mc-world": "file:../../vendor/agent-mc-world-0.5.7-rc.160-preview.142-865cd324.tgz",
    "agent-mc-qiandengji": "file:../../vendor/agent-mc-qiandengji-0.5.0-rc.50-preview.108-ce2d93fc.tgz"
  }
}
