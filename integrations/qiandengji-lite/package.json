{
  "name": "cortico-world-qiandengji-lite",
  "version": "0.1.0",
  "type": "module",
  "description": "千灯纪-lite：官方 Minecraft World 的最小服务器接入扩展，提供私密自动登录、官网接入及只读服务器信息。",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.28.6",
  "keywords": ["cortico-world", "minecraft", "qiandengji", "cortico"],
  "repository": { "type": "git", "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git", "directory": "integrations/qiandengji-lite" },
  "cortico": {
    "kind": "world", "api": 6, "displayName": "千灯纪-lite",
    "tags": ["game", "external-setup", "experimental", "unsafe", "high-cost"],
    "describe": "describe.json", "webUiClient": "dist/webui.js", "webUiStyle": "dist/webui.css"
  },
  "files": ["dist", "describe.json", "README.md", "CHANGELOG.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "UPSTREAM.json", "scripts/verify.mjs", "client/profile.mjs", "client/configure.mjs", "client/request-camera.mjs", "client/configure-password.ps1", "client/README.md", "client/mods.json"],
  "scripts": { "build": "node scripts/build.mjs", "test": "vitest run", "typecheck": "tsc --noEmit", "release:stage":"node scripts/stage.mjs", "prepack": "node scripts/verify.mjs" },
  "dependencies": { "mineflayer": "4.37.1", "mineflayer-pathfinder": "2.4.5", "prismarine-viewer": "1.33.0", "vec3": "0.1.10" },
  "peerDependencies": { "cortico": ">=0.2.11 <0.3.0" },
  "devDependencies": {
    "@types/node": "^22.10.0", "cortico": "0.2.11", "esbuild": "0.28.2", "typescript": "^5.7.2", "vitest": "2.1.8", "tsx": "^4.19.2", "jsdom":"30.0.1",
    "agent-mc-world": "file:../../vendor/agent-mc-world-0.5.7-rc.149-preview.1.tgz",
    "agent-mc-qiandengji": "file:../../vendor/agent-mc-qiandengji-0.5.0-rc.45-preview.1.tgz"
  }
}
