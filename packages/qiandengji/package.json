{
  "name": "agent-mc-qiandengji",
  "version": "0.5.0-rc.26",
  "type": "module",
  "description": "Explicit Qiandengji server protocols and reference pack for the independent Agent Minecraft client",
  "license": "MIT",
  "main": "./dist/neutral.js",
  "exports": {
    ".": {
      "types": "./dist/types/integrations/qiandengji/neutral.d.ts",
      "default": "./dist/neutral.js"
    },
    "./portal": {
      "types": "./dist/types/integrations/qiandengji/portal-access.d.ts",
      "default": "./dist/portal-access.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.mts",
      "default": "./dist/presentation.mjs"
    },
    "./host-decisions": {
      "types": "./dist/types/integrations/qiandengji/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./manifest": {
      "types": "./dist/types/integrations/qiandengji/data-packs/qiandengji/manifest.d.ts",
      "default": "./dist/data-packs/qiandengji/manifest.js"
    }
  },
  "dependencies": {
    "vec3": "0.2.0"
  },
  "peerDependencies": {
    "agent-mc-world": "^0.5.7-rc.90"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git",
    "directory": "packages/qiandengji"
  },
  "types": "./dist/types/integrations/qiandengji/neutral.d.ts"
}
