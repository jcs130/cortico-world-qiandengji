{
  "name": "agent-mc-qiandengji-workspace",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Qiandengji server extension and Cortico World adapter; consumes the independent agent-mc-world package",
  "packageManager": "pnpm@11.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git"
  },
  "scripts": {
    "build": "node scripts/build-extensions.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "test": "vitest run",
    "test:release": "vitest run --maxWorkers=4 --minWorkers=1",
    "typecheck": "tsc --noEmit -p tsconfig.integration.json && tsc --noEmit -p tsconfig.web.json",
    "release:pack": "node scripts/prepare-release.mjs",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "agent-mc-world": "file:vendor/agent-mc-world-0.5.7-rc.49-5bab11d3.tgz",
    "vec3": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "socket.io-client": "4.8.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@modelcontextprotocol/sdk": "1.32.1",
    "minecraft-data": "3.112.0",
    "mineflayer": "4.37.1",
    "cortico": "0.2.3"
  }
}
