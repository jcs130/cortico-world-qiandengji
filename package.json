{
  "name": "agent-mc-world",
  "version": "0.3.0-next.2",
  "type": "module",
  "description": "Independent Mineflayer execution client for Agents, with MCP, SDK, skill and Cortico World adapters",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcs130/cortico-world-qiandengji.git"
  },
  "homepage": "https://github.com/jcs130/cortico-world-qiandengji#readme",
  "bugs": {
    "url": "https://github.com/jcs130/cortico-world-qiandengji/issues"
  },
  "license": "MIT",
  "keywords": [
    "minecraft",
    "mineflayer",
    "agent",
    "mcp",
    "cortico-world"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
  "bin": {
    "minecraft-agent-client": "./bin/minecraft-agent-client.mjs",
    "minecraft-agent-mcp": "./bin/minecraft-agent-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/types/src/client/index.d.ts",
      "default": "./src/client/index.ts"
    },
    "./contracts": {
      "types": "./dist/types/src/client/contracts.d.ts",
      "default": "./src/client/contracts.ts"
    },
    "./adapters/cortico": {
      "types": "./dist/types/src/adapters/minecraft.d.ts",
      "default": "./src/adapters/minecraft.ts"
    },
    "./mcp": {
      "types": "./dist/types/src/mcp/server.d.ts",
      "default": "./src/mcp/server.ts"
    },
    "./package.json": "./package.json",
    "./mcp/stdio": {
      "types": "./dist/types/src/mcp/stdio.d.ts",
      "default": "./src/mcp/stdio.ts"
    }
  },
  "cortico": {
    "kind": "world",
    "api": 5,
    "displayName": "Agent MC World",
    "consoleClient": "dist/console.js",
    "consoleStyle": "dist/console.css"
  },
  "files": [
    "src/client",
    "src/runtime",
    "src/mcp/server.ts",
    "src/mcp/stdio.ts",
    "src/adapters/minecraft.ts",
    "src/index.ts",
    "src/definition.ts",
    "src/console-client.ts",
    "src/connection-panel.ts",
    "src/viewer-agent.d.mts",
    "src/chat-provenance.ts",
    "src/collect-contract.ts",
    "src/mounted-look.ts",
    "src/vehicle-state.ts",
    "src/railway.ts",
    "src/viewer-photo-page.d.mts",
    "bin/minecraft-agent-mcp.mjs",
    "bin/minecraft-agent-client.mjs",
    "docs/architecture.md",
    "docs/minecraft-client.md",
    "docs/online-accounts.md",
    "docs/agent-mcp.md",
    "docs/harness.md",
    "docs/migration-0.3.md",
    "examples/agent-mcp-check.mjs",
    "examples/minecraft-agent.json",
    "examples/minecraft-online.json",
    "examples/minecraft-client.ts",
    "skills",
    "engine",
    "dist",
    "patches",
    "client-login",
    "scripts/build-client-login.mjs",
    "references/battlefield-protocol.md",
    "release-sources.json",
    "README.md",
    "DEPLOYMENT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:engine && pnpm run build:console && pnpm run build:viewer && pnpm run build:types && pnpm run verify:release",
    "build:engine": "tsx scripts/build-release.ts engine",
    "build:console": "node scripts/build-console.mjs",
    "build:viewer": "tsx scripts/build-release.ts viewer",
    "build:client-login": "node scripts/build-client-login.mjs",
    "start:mcp": "node bin/minecraft-agent-mcp.mjs",
    "start:minecraft": "node bin/minecraft-agent-client.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepack": "node scripts/verify-release.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:types": "node scripts/build-types.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "minecraft-data": "3.112.0",
    "mineflayer": "4.37.1",
    "mineflayer-pathfinder": "2.4.5",
    "playwright-core": "1.63.0",
    "prismarine-block": "1.23.0",
    "prismarine-auth": "3.1.1",
    "prismarine-viewer": "1.33.0",
    "ses": "2.3.0",
    "socket.io": "4.8.3",
    "tsx": "4.23.15",
    "vec3": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "0.1.8",
    "esbuild": "^0.28.2",
    "socket.io-client": "4.8.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "types": "./dist/types/src/index.d.ts"
}
