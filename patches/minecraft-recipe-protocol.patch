diff --git a/recipe-protocol.ts b/recipe-protocol.ts
new file mode 100644
--- /dev/null
+++ b/recipe-protocol.ts
@@ -0,0 +1,25 @@
+type Field = { name: string; type: unknown };
+type RecipeRegistry = {
+  version: { minecraftVersion: string };
+  protocol: { play: { toClient: { types: { packet_declare_recipes: [string, Array<{
+    name: string; type: [string, { type: [string, Field[]] }];
+  }>] } } } };
+};
+
+/** Protocol 766 omits banneraddpattern; later serializers retain contiguous wire IDs. */
+export function repairRecipeSerializers(value: unknown): boolean {
+  const registry = value as RecipeRegistry;
+  if (!['1.20.5', '1.20.6'].includes(registry.version.minecraftVersion)) return false;
+  const recipes = registry.protocol.play.toClient.types.packet_declare_recipes[1]
+    .find(field => field.name === 'recipes');
+  const type = recipes?.type[1].type[1].find(field => field.name === 'type')?.type as
+    [string, { mappings: Record<string, string> }] | undefined;
+  if (type?.[0] !== 'mapper') return false;
+  const entries = Object.entries(type[1].mappings);
+  const removed = entries.find(([, name]) => name === 'minecraft:crafting_special_banneraddpattern');
+  if (!removed) return false;
+  const index = Number(removed[0]);
+  type[1].mappings = Object.fromEntries(entries.filter(([key]) => key !== removed[0])
+    .map(([key, name]) => [Number(key) > index ? String(Number(key) - 1) : key, name]));
+  return true;
+}
